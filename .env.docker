APP_NAME=GPEDocs
APP_ENV=production
APP_KEY=          # gere com: php artisan key:generate --show
APP_DEBUG=false
APP_URL=http://localhost
APP_PORT=80

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ── Banco de dados EXTERNO ao Docker ─────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=           # IP/hostname do banco externo (não use 127.0.0.1)
DB_PORT=3306
DB_DATABASE=gpedocs
DB_USERNAME=gpedocs
DB_PASSWORD=

# ── Banco legado (importação) ─────────────────────────────────────────────────
# GPE_LEGADO_HOST=
# GPE_LEGADO_PORT=3306
# GPE_LEGADO_DATABASE=gpdparaguacu
# GPE_LEGADO_USERNAME=
# GPE_LEGADO_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=landlord
DB_QUEUE_TABLE=gpedocs_jobs
DB_FAILED_CONNECTION=landlord
DB_FAILED_TABLE=gpedocs_failed_jobs
DB_BATCH_TABLE=gpedocs_job_batches
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@gpedocs.local"
MAIL_FROM_NAME="${APP_NAME}"


LANDLORD_URL=https://admin.maatgpecloud.com.br
DEV_LANDLORD_URL=localhost
DEV_LANDLORD_PORT=8080
# INSIRA O SERVER NAME PERSONALIZADO, A PORTA EXTERNA DO CONTAINER OU PORTA 8080
DEV_TENANT_DEFAULT_DOMAIN=:8090
#TENANT_DEFAULT_DOMAIN=
TENANT_URL_TEMPLATE=https://{domain}.gpedocs.com.br
