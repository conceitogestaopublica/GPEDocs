APP_NAME=GPEDocs
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Porta do nginx-docs no host. Em dev ela É o identificador dos tenants: o
# ResolveTenant procura no landlord tenant com domain=':<porta>' e subdomain='localhost'.
APP_PORT=8090
APP_URL=http://localhost:8090
VITE_PORT=5174

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Conexão default ────────────────────────────────────────────────────
# Igual ao gpe2: antes de resolver o tenant a conexão default é o landlord; o
# ResolveTenant troca para 'tenant' (banco do município, lido da linha em
# `tenants`) antes de qualquer query da aplicação. Não há banco próprio do GPEDocs.
DB_CONNECTION=landlord

# ─── Landlord (catálogo central de tenants) — do gpe2, compartilhado ────
# Container postgres-gpe, alcançado pela rede docker gpe_gpe (porta interna 5432).
# Fora do Docker (host WSL/Windows): LANDLORD_DB_HOST=127.0.0.1 e LANDLORD_DB_PORT=5433.
# O cadastro de tenants é feito SÓ no painel do gpe2 (LANDLORD_URL).
LANDLORD_DB_HOST=postgres-gpe
LANDLORD_DB_PORT=5432
LANDLORD_DB_DATABASE=landlord
LANDLORD_DB_USERNAME=root
LANDLORD_DB_PASSWORD=(t_7Tq

# ─── Tenants do GPEDocs ─────────────────────────────────────────────────
# O que separa os tenants do GPEDocs dos do gpe2 no landlord é a coluna `domain`.
# Os comandos console (tenant:migrate etc.) só operam nos tenants desse domínio.
# Dev:  :<APP_PORT>          Prod: gpedocs.com.br
TENANT_DOMINIO_BASE=:8090

# Template da URL pública dos tenants. {subdomain} e {domain} são substituídos
# pelas colunas homônimas do tenant (host = {subdomain}.{domain}).
# Em dev (domain=':porta') não é usado: a URL vira http://localhost:<porta>.
TENANT_URL_TEMPLATE=https://{subdomain}.{domain}

# TTL do token SSO emitido pelo landlord. Curto de propósito (defesa contra replay).
TENANT_SSO_TOKEN_TTL=30

# Painel landlord (gpe2). /landlord/* e tenant não encontrado redirecionam para cá.
# Dev: http://localhost:8080 (web-gpe)   Prod: https://admin.maatgpecloud.com.br
LANDLORD_URL=http://localhost:8080

# ─── Sessão / cookies ───────────────────────────────────────────────────
# SESSION_CONNECTION vazio: a sessão segue a conexão default, que o ResolveTenant
# troca para 'tenant' antes do StartSession — cada município grava em `sessions`
# do próprio banco. SESSION_DOMAIN=null mantém o cookie limitado ao host atual.
SESSION_DRIVER=database
SESSION_CONNECTION=
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ─── Fila ───────────────────────────────────────────────────────────────
# Fica no landlord, com tabelas PRÓPRIAS do GPEDocs (gpe2 usa gpe2_*).
# Criar/atualizar com: php artisan landlord:migrate
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=landlord
DB_QUEUE_TABLE=gpedocs_jobs
DB_QUEUE_RETRY_AFTER=90
DB_FAILED_CONNECTION=landlord
DB_FAILED_TABLE=gpedocs_failed_jobs
DB_BATCH_TABLE=gpedocs_job_batches

# file (como no gpe2): 'database' gravaria cache no landlord quando não há tenant.
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@gpedocs.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Banco legado (importação de usuários — db:mass-insert-users) ───────
GPE_LEGADO_HOST=localhost
GPE_LEGADO_DATABASE=gpdweb
GPE_LEGADO_USERNAME=gpdweb
GPE_LEGADO_PASSWORD=
