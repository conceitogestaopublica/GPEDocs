APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=host.docker.internal
DB_PORT=5432
DB_SCHEMA_PGSQL=
DB_DATABASE=gpddocs
DB_USERNAME=postgres
DB_PASSWORD=

# Landlord (HML) — catálogo central de tenants
LANDLORD_DB_HOST=host.docker.internal
LANDLORD_DB_PORT=3306
LANDLORD_DB_DATABASE=gpe2landlord
LANDLORD_DB_USERNAME=root
LANDLORD_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# CADA PROJETO PRECISA CRIAR SUAS PRÓPRIAS TABELAS DE JOBS
DB_QUEUE_CONNECTION=landlord
DB_QUEUE_TABLE=docs_jobs
DB_FAILED_CONNECTION=landlord
DB_FAILED_TABLE=docs_failed_jobs
DB_BATCH_TABLE=gpedocs_job_batches

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

LANDLORD_URL=https://admin.gpedocs.com.br
DEV_LANDLORD_URL=localhost
# INSIRA O SERVER NAME PERSONALIZADO, A PORTA EXTERNA DO CONTAINER OU PORTA 8080
DEV_TENANT_DEFAULT_DOMAIN=:8090
#TENANT_DEFAULT_DOMAIN=gpedocs.com.br
TENANT_URL_TEMPLATE=https://{domain}.gpedocs.com.br


# DADOS DO BANCO DE DADO LEGACY
GPE_LEGADO_HOST=localhost
GPE_LEGADO_DATABASE=gpdweb
GPE_LEGADO_USERNAME=gpdweb
GPE_LEGADO_PASSWORD=
